# Copy to .env.bot next to .env on the server (docker compose env_file of the bot).
# Holds only what the bot needs: the backend never reads these values.

# CHANGE: token from @BotFather.
BOT_TOKEN=
# CHANGE: the same value as TELEGRAM_BOT_API_SECRET in .env.
TELEGRAM_BOT_API_SECRET=
# CHANGE: BOT_DB_PASSWORD from .env. The calmap_bot role sees schema "bot" only.
DATABASE_URL=postgresql+asyncpg://calmap_bot:change-this-bot-password@db:5432/calmap

# CHANGE: YooKassa shop credentials.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Where YooKassa returns the user after paying: the bot's link.
YOOKASSA_RETURN_URL=https://t.me/your_bot_username
# 54-FZ receipts through YooKassa (enable receipts in the shop settings first).
YOOKASSA_RECEIPTS=true
# Receipt VAT code: 1 = без НДС (YooKassa vat_code table).
YOOKASSA_VAT_CODE=1
PRICE_BASE_RUB=299
PRICE_PRO_RUB=499
SUBSCRIPTION_DAYS=30

# Telegram through the SSH tunnel abroad (docker-compose.egress.yml); empty — direct.
TELEGRAM_PROXY_URL=

# CHANGE: public API domain (links to the terms and the privacy policy).
PUBLIC_BASE_URL=https://api.example.ru
LEGAL_CONTACT_EMAIL=
# CHANGE: seller shown with prices and in /help (needed for YooKassa moderation).
SELLER_INFO=ИП Фамилия Имя Отчество, ИНН 000000000000, ОГРНИП 000000000000000
