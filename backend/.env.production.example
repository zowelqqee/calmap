# Copy to .env on the server and replace every value marked CHANGE.
ENV=production
DEBUG=false
# CHANGE: generate with `openssl rand -hex 32`
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# CHANGE: public API domain; Caddy obtains the HTTPS certificate for it.
DOMAIN=api.example.ru
CORS_ORIGINS=https://api.example.ru
RECIPE_IMAGE_PUBLIC_BASE_URL=https://api.example.ru

# PostgreSQL. POSTGRES_USER is the superuser for maintenance and backups; the
# backend connects as calmap_app (no superuser rights) and the bot as calmap_bot
# (schema "bot" only), see docker/db-roles.sh. CHANGE all three passwords
# (openssl rand -hex 24); APP_DB_PASSWORD also goes into DATABASE_URL, and
# BOT_DB_PASSWORD into DATABASE_URL of .env.bot.
POSTGRES_DB=calmap
POSTGRES_USER=calmap
POSTGRES_PASSWORD=change-this-superuser-password
APP_DB_PASSWORD=change-this-app-password
BOT_DB_PASSWORD=change-this-bot-password
DATABASE_URL=postgresql+asyncpg://calmap_app:change-this-app-password@db:5432/calmap

WEB_CONCURRENCY=2
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=60
AUTH_RATE_LIMIT_PER_MINUTE=20

# CHANGE: legal entity shown in /legal/privacy and /legal/terms (152-FZ).
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=

# Sign-in with VK ID (the only external sign-in allowed for Russian services).
VK_CLIENT_ID=

# AI consultant processor named in the user's consent (cross-border if abroad).
ASSISTANT_PROCESSOR_NAME=
ASSISTANT_PROCESSOR_COUNTRY=

# Sign-in by SMS code through SMS.ru. CHANGE: API key from the SMS.ru dashboard;
# SMS_SENDER is an approved sender name (empty = provider default).
SMS_PROVIDER=smsru
SMSRU_API_ID=
SMS_SENDER=
SMS_DAILY_LIMIT=2000
# Codes per day from one IPv4 address / IPv6 /64 (mobile CGNAT shares addresses).
SMS_PER_NETWORK_DAILY=100

# Subscriptions. Users pay in the Telegram bot; the bot pushes payment status to
# /v1/bot/* with this secret in X-Bot-Secret. CHANGE: openssl rand -hex 32, the
# same value in .env.bot. The bot's own settings live in .env.bot only.
TRIAL_DAYS=3
TELEGRAM_BOT_API_SECRET=
# /v1/bot/* is closed on the public domain; list addresses here only for a bot
# that runs on another server.
BOT_ALLOWED_IPS=

# Providers (stub answers are refused in production; see INTEGRATIONS.md).
VISION_PROVIDER=stub
VISION_API_KEY=
VISION_BASE_URL=
GEMINI_API_KEY=
ASSISTANT_PROVIDER=stub
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=
RETAIL_PROVIDER=stub

# Recipe photos: set to openai_compatible and provide a key to generate them.
RECIPE_IMAGE_PROVIDER=disabled
RECIPE_IMAGE_API_KEY=
# Optional shared proxy for OpenAI-compatible requests:
# http://user:password@host:port or socks5://user:password@host:port
OPENAI_PROXY_URL=
RECIPE_IMAGE_STORAGE_DIR=media/recipes

DEFAULT_REGION_CODE=RU-MOW
DEFAULT_CURRENCY=RUB

# Daily pg_dump (backup service): directory on the host and retention. With a
# passphrase the dumps are encrypted; keep it outside the server as well.
BACKUP_DIR=../backups
BACKUP_KEEP_DAYS=14
BACKUP_PASSPHRASE=
