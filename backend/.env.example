# --- App ---
ENV=local
DEBUG=true
SECRET_KEY=change-me-in-production-min-32-chars-long
CORS_ORIGINS=

# --- Database (async driver) ---
DATABASE_URL=postgresql+asyncpg://localhost:5432/calmap

# --- Auth: sign-in by SMS code (stub | smsru) ---
SMS_PROVIDER=stub
SMSRU_API_ID=
SMS_SENDER=
SMS_DAILY_LIMIT=2000

# --- Tokens ---
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=60

# --- OAuth (leave empty in local dev; providers are stubbed) ---
VK_CLIENT_ID=

# --- Vision / LLM ---
# stub | gemini
VISION_PROVIDER=stub
GEMINI_API_KEY=
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=gpt-4o-mini
# Egress proxy for reaching non-RU LLM providers from a RU-hosted backend.
LLM_PROXY_BASE_URL=

# --- Scheduled recipe image generation ---
# disabled | openai_compatible. Runs daily at 05:00 Europe/Moscow.
RECIPE_IMAGE_PROVIDER=disabled
RECIPE_IMAGE_API_KEY=
RECIPE_IMAGE_BASE_URL=https://api.openai.com/v1
RECIPE_IMAGE_MODEL=gpt-image-2
RECIPE_IMAGE_SIZE=1536x1024
RECIPE_IMAGE_QUALITY=low
RECIPE_IMAGE_STORAGE_DIR=media/recipes
RECIPE_IMAGE_PUBLIC_BASE_URL=http://127.0.0.1:8000

# AI assistant (stub | openai_compatible)
ASSISTANT_PROVIDER=stub
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=gpt-4o-mini

# Subscriptions: payment in a Telegram bot, status pushed to /v1/bot/*
TRIAL_DAYS=3
# Shared secret the bot sends in X-Bot-Secret (openssl rand -hex 32)
TELEGRAM_BOT_API_SECRET=
# Bot @username without "@" for sign-in codes in Telegram; empty — SMS only
TELEGRAM_BOT_USERNAME=

# Retail offers (stub | http | parse_bot)
RETAIL_PROVIDER=stub
RETAIL_BASE_URL=
RETAIL_API_KEY=
# Optional: managed public-catalog adapter for Pyaterochka. It keeps the app out
# of bot/CAPTCHA circumvention. STORE_ID is mandatory so "in stock" always means
# a concrete selected store rather than a vague network-wide catalogue match.
RETAIL_PARSE_API_KEY=
RETAIL_PARSE_5KA_SCRAPER_ID=
RETAIL_PARSE_5KA_STORE_ID=

# VK ID verification
VK_USERINFO_URL=https://id.vk.com/oauth2/user_info

# --- Business defaults ---
DEFAULT_REGION_CODE=RU-MOW
DEFAULT_CURRENCY=RUB

# --- Abuse protection and legal pages ---
AUTH_RATE_LIMIT_PER_MINUTE=20
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
ASSISTANT_PROCESSOR_NAME=
ASSISTANT_PROCESSOR_COUNTRY=
